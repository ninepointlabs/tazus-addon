# Example user unit (no secrets). Install with the steps in ../README.md.
# Adjust the paths if your repo or WoW install live elsewhere.
[Unit]
Description=Tazu's Addon: poll WoW Forever Shaman, totem and imbue change feeds
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/Projects/tazus-addon/tools/shaman-changes-poller/poller.py \
  --output "%h/Projects/tazus-addon/Data/Changes.lua" \
  --output "%h/Games/battlenet/drive_c/Program Files (x86)/World of Warcraft/_forever_/Interface/AddOns/TazusAddon/Data/Changes.lua"
Nice=10
